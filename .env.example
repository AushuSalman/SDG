# ---- required
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sdg?retryWrites=true&w=majority   # MongoDB Atlas, Mumbai
PAYLOAD_SECRET=change-me-32-random-characters
NEXT_PUBLIC_SERVER_URL=https://www.sdg.in

# ---- first admin (used by npm run seed only)
SEED_ADMIN_EMAIL=admin@sdg.in
SEED_ADMIN_PASSWORD=change-me

# ---- AWS (Bedrock, S3, SES). On Lightsail use an IAM user key; leave blank locally for mock mode.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=                  # media and documents; empty = local disk
MEDIA_HOST=                 # CloudFront hostname serving the bucket, for next/image

# ---- AI assistant (Bedrock India inference profile: processing stays in Mumbai + Hyderabad)
AI_MODE=                    # live | mock (defaults to live when AWS credentials exist)
BEDROCK_MODEL_CLASSIFY=in.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ANSWER=in.anthropic.claude-haiku-4-5-20251001-v1:0   # or in.anthropic.claude-sonnet-5 for higher-quality answers
BEDROCK_MODEL_EMBED=amazon.titan-embed-text-v2:0
ATLAS_VECTOR_INDEX=chunks_vector   # Atlas Vector Search index on document-chunks.embedding (512 dims, cosine)
ALERT_EMAIL=

# ---- messaging
OTP_MODE=                   # mock to print codes to the console instead of sending SMS
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SES_FROM=                   # e.g. no-reply@sdg.in (domain verified in SES, production access granted)

# ---- CRM
PROPFLO_API_URL=            # sandbox first
PROPFLO_API_KEY=

# ---- jobs
PAYLOAD_JOBS_AUTORUN=true   # the container processes its own queue every minute
CRON_SECRET=                # optional: lets an external cron hit /api/payload-jobs/run
